@model ProjetoIntegrador_Petroleo.Models.OrdemServico
@using ProjetoIntegrador_Petroleo.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Nova ordem de serviço";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">PLANEJAMENTO DE MANUTENÇÃO</p>
        <h1>Nova ordem de serviço</h1>
        <p class="page-subtitle">Registre uma intervenção e acompanhe sua aprovação e execução.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar para ordens</a>
</section>

<section class="create-card">
    <div class="create-card-heading">
        <span class="create-card-icon" aria-hidden="true">▤</span>
        <div>
            <h2>Detalhes da solicitação</h2>
            <p>Informe o equipamento, o escopo do serviço e o nível de prioridade.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="create-form">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <input type="hidden" asp-for="AlertaId" />

        @if (Model.AlertaId != null)
        {
            <div class="create-context-note">
                <span aria-hidden="true">◉</span>
                Esta ordem será vinculada ao alerta <strong>#@Model.AlertaId</strong>.
            </div>
        }

        <div class="create-form-grid">
            <div class="create-field create-field-wide">
                <label asp-for="AtivoId" class="form-label">Equipamento</label>
                <select asp-for="AtivoId" asp-items="(SelectList)ViewBag.Ativos" class="form-select">
                    <option value="">Selecione o equipamento</option>
                </select>
                <span asp-validation-for="AtivoId" class="field-validation"></span>
            </div>

            <div class="create-field create-field-wide">
                <label asp-for="OperadorId" class="form-label">Operador responsável <span class="create-label-optional">opcional</span></label>
                <select asp-for="OperadorId" asp-items="(SelectList)ViewBag.Operadores" class="form-select">
                    <option value="">Atribuir depois</option>
                </select>
                <span asp-validation-for="OperadorId" class="field-validation"></span>
                <span class="create-field-hint">O operador atribuído poderá acompanhar esta OS na própria lista.</span>
            </div>

            <div class="create-field create-field-wide">
                <label asp-for="Titulo" class="form-label">Título da ordem</label>
                <input asp-for="Titulo" class="form-control" placeholder="Ex.: Inspeção do sistema de bombeamento" />
                <span asp-validation-for="Titulo" class="field-validation"></span>
            </div>

            <div class="create-field create-field-wide">
                <label asp-for="Descricao" class="form-label">Descrição do serviço</label>
                <textarea asp-for="Descricao" class="form-control" rows="5" placeholder="Descreva a intervenção necessária, os sintomas ou as etapas previstas."></textarea>
                <span asp-validation-for="Descricao" class="field-validation"></span>
            </div>

            <div class="create-field">
                <label asp-for="Prioridade" class="form-label"></label>
                <select asp-for="Prioridade" asp-items="Html.GetEnumSelectList<Prioridade>()" class="form-select"></select>
                <span asp-validation-for="Prioridade" class="field-validation"></span>
            </div>
        </div>

        <div class="create-form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Abrir ordem de serviço <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
