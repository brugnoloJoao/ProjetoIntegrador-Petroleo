@model ProjetoIntegrador_Petroleo.Models.OrdemServico
@using ProjetoIntegrador_Petroleo.Models
@{
    ViewData["Title"] = "Nova ordem de serviço";
}

<h1>Nova ordem de serviço</h1>

<form asp-action="Create" method="post" style="max-width:640px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="AlertaId" />

    @if (Model.AlertaId != null)
    {
        <div class="alert alert-info">Esta OS será vinculada ao alerta #@Model.AlertaId.</div>
    }

    <div class="mb-3">
        <label asp-for="AtivoId" class="form-label">Equipamento</label>
        <select asp-for="AtivoId" asp-items="(SelectList)ViewBag.Ativos" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Prioridade" class="form-label"></label>
        <select asp-for="Prioridade" asp-items="Html.GetEnumSelectList<Prioridade>()" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Abrir OS</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}