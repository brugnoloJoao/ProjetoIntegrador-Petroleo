@model IEnumerable<ProjetoIntegrador_Petroleo.Models.OrdemServico>
@using ProjetoIntegrador_Petroleo.Models
@{
    ViewData["Title"] = "Ordens de Serviço";
    var filtro = ViewData["Filtro"] as string ?? "";
}

<div class="page-heading">
    <div><p class="eyebrow">Planejamento de manutenção</p><h1>Ordens de serviço</h1><p class="page-subtitle">Acompanhe prioridades e andamento das manutenções.</p></div>
    @if (User.IsInRole("Operador") || User.IsInRole("Engenheiro") || User.IsInRole("Gestor"))
    {
        <a class="btn btn-primary" asp-action="Create">＋ Cadastrar nova OS</a>
    }
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

<div id="os-filters-app" class="mb-3" data-status="@filtro" data-statuses="@string.Join(",", Enum.GetNames<StatusOrdem>())"></div>

@if (!Model.Any())
{
    <div class="empty-state empty-notice">
        <div class="empty-state-icon">▤</div>
        <h2 class="section-title">Nenhuma ordem de serviço cadastrada</h2>
        <p>@(User.IsInRole("Operador") && !User.IsInRole("Engenheiro") && !User.IsInRole("Gestor") ? "As ordens atribuídas a você aparecerão aqui." : "As ordens de serviço abertas aparecerão aqui para acompanhamento.")</p>
        @if (User.IsInRole("Operador") || User.IsInRole("Engenheiro") || User.IsInRole("Gestor"))
        {
            <a class="btn btn-primary" asp-action="Create">＋ Cadastrar nova OS</a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>#</th><th>Título</th><th>Equipamento</th><th>Operador responsável</th><th>Prioridade</th><th>Status</th><th>Abertura</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr data-order-row data-status="@o.Status" data-search="@($"{o.Id} {o.Titulo} {o.Ativo?.Nome} {o.Operador?.Email} {o.Prioridade} {o.Status}")">
                        <td>@o.Id</td>
                        <td>@o.Titulo</td>
                        <td>@o.Ativo?.Nome</td>
                        <td>@(o.Operador?.Email ?? "Não atribuído")</td>
                        <td>
                            <span class="badge @(o.Prioridade == Prioridade.Alta ? "bg-danger" : o.Prioridade == Prioridade.Media ? "bg-warning text-dark" : "bg-secondary")">@o.Prioridade</span>
                        </td>
                        <td>
                            <span class="badge @(o.Status switch
                                  {
                                      StatusOrdem.Aberta => "bg-info text-dark",
                                      StatusOrdem.Aprovada => "bg-primary",
                                      StatusOrdem.EmAndamento => "bg-warning text-dark",
                                      StatusOrdem.Encerrada => "bg-success",
                                      _ => "bg-secondary"
                                  })">@o.Status</span>
                        </td>
                        <td>@o.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@o.Id">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script type="module" src="~/dist/filters.js" asp-append-version="true"></script>
}
