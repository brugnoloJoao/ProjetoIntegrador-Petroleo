@model IEnumerable<ProjetoIntegrador_Petroleo.Models.OrdemServico>
@using ProjetoIntegrador_Petroleo.Models
@{
    ViewData["Title"] = "Ordens de Serviço";
    var filtro = ViewData["Filtro"] as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Ordens de Serviço</h1>
    @if (User.IsInRole("Engenheiro"))
    {
        <a class="btn btn-primary" asp-action="Create">Nova OS</a>
    }
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

<div class="btn-group mb-3 flex-wrap">
    <a class="btn btn-outline-secondary @(filtro == "" ? "active" : "")" asp-action="Index">Todas</a>
    @foreach (var s in Enum.GetValues<StatusOrdem>())
    {
        <a class="btn btn-outline-secondary @(filtro == s.ToString() ? "active" : "")"
           asp-action="Index" asp-route-status="@s">@s</a>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">Nenhuma ordem de serviço encontrada.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>#</th><th>Título</th><th>Equipamento</th><th>Prioridade</th><th>Status</th><th>Abertura</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.Titulo</td>
                        <td>@o.Ativo?.Nome</td>
                        <td>
                            <span class="badge @(o.Prioridade == Prioridade.Alta ? "bg-danger" : o.Prioridade == Prioridade.Media ? "bg-warning text-dark" : "bg-secondary")">@o.Prioridade</span>
                        </td>
                        <td>
                            <span class="badge @(o.Status switch
                                  {
                                      StatusOrdem.Aberta => "bg-info text-dark",
                                      StatusOrdem.Aprovada => "bg-primary",
                                      StatusOrdem.EmAndamento => "bg-warning text-dark",
                                      StatusOrdem.Encerrada => "bg-success",
                                      _ => "bg-secondary"
                                  })">@o.Status</span>
                        </td>
                        <td>@o.DataAbertura.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@o.Id">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}