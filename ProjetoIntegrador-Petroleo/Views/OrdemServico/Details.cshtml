@model ProjetoIntegrador_Petroleo.Models.OrdemServico
@using ProjetoIntegrador_Petroleo.Models
@{
    ViewData["Title"] = "OS #" + Model.Id;
}

<h1>OS #@Model.Id – @Model.Titulo</h1>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Equipamento</dt>
    <dd class="col-sm-9">@Model.Ativo?.Nome (@Model.Ativo?.Tag)</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Prioridade</dt>
    <dd class="col-sm-9">@Model.Prioridade</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>

    @if (Model.Alerta != null)
    {
        <dt class="col-sm-3">Alerta de origem</dt>
        <dd class="col-sm-9">
            @Model.Alerta.Parametro?.Nome, @Model.Alerta.Severidade em @Model.Alerta.DataHora.ToString("dd/MM/yyyy HH:mm")
        </dd>
    }

    <dt class="col-sm-3">Solicitante</dt>
    <dd class="col-sm-9">@Model.SolicitanteId em @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")</dd>

    @if (Model.AprovadorId != null)
    {
        <dt class="col-sm-3">Analisada por</dt>
        <dd class="col-sm-9">@Model.AprovadorId em @Model.DataAprovacao?.ToString("dd/MM/yyyy HH:mm")</dd>
    }
    @if (Model.DataEncerramento != null)
    {
        <dt class="col-sm-3">Encerrada em</dt>
        <dd class="col-sm-9">@Model.DataEncerramento?.ToString("dd/MM/yyyy HH:mm")</dd>
    }
</dl>

<div class="d-flex gap-2">
    @if (Model.Status == StatusOrdem.Aberta && User.IsInRole("Gestor"))
    {
        <form asp-action="Decidir" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="aprovar" value="true" />
            <button class="btn btn-success">Aprovar</button>
        </form>
        <form asp-action="Decidir" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="aprovar" value="false" />
            <button class="btn btn-danger">Rejeitar</button>
        </form>
    }
    @if (Model.Status == StatusOrdem.Aprovada && User.IsInRole("Engenheiro"))
    {
        <form asp-action="Iniciar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-primary">Iniciar manutenção</button>
        </form>
    }
    @if (Model.Status == StatusOrdem.EmAndamento && User.IsInRole("Engenheiro"))
    {
        <form asp-action="Encerrar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-success">Encerrar OS</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>