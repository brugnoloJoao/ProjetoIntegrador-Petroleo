@model ProjetoIntegrador_Petroleo.Models.OrdemServico
@using ProjetoIntegrador_Petroleo.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "OS #" + Model.Id;
    var statusClass = Model.Status switch
    {
        StatusOrdem.Aberta => "bg-info",
        StatusOrdem.Aprovada => "bg-primary",
        StatusOrdem.EmAndamento => "bg-warning",
        StatusOrdem.Encerrada => "bg-success",
        _ => "bg-secondary"
    };
    var prioridadeClass = Model.Prioridade switch
    {
        Prioridade.Alta => "bg-danger",
        Prioridade.Media => "bg-warning",
        _ => "bg-secondary"
    };
}

<section class="page-heading detail-page-heading">
    <div>
        <p class="eyebrow">PLANEJAMENTO DE MANUTENÇÃO · OS #@Model.Id</p>
        <div class="detail-title-line">
            <h1>@Model.Titulo</h1>
            <span class="badge @statusClass">@Model.Status</span>
            @if (TempData["Sucesso"] != null)
            {
                @* Confirmação discreta da ação que acabou de ser feita. *@
                <span class="os-done @(Model.Status == StatusOrdem.Rejeitada ? "is-rejected" : "")" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="@(Model.Status == StatusOrdem.Rejeitada ? "M8.5 8.5l7 7M15.5 8.5l-7 7" : "M7.5 12.5l3.2 3.2 6-6.6")" /></svg>
                </span>
            }
        </div>
        <p class="page-subtitle">Aberta em @Model.DataAbertura.HorarioDeBrasilia("dd/MM/yyyy 'às' HH:mm")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar para ordens</a>
</section>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

<div class="detail-summary-grid detail-summary-grid-os">
    <article class="card detail-summary-card">
        <span class="detail-summary-icon">◈</span>
        <div><span class="detail-summary-label">Equipamento</span><strong>@Model.Ativo?.Nome</strong><span class="asset-tag">@Model.Ativo?.Tag</span></div>
    </article>
    <article class="card detail-summary-card">
        <span class="detail-summary-icon">⚑</span>
        <div><span class="detail-summary-label">Prioridade</span><span class="badge @prioridadeClass">@Model.Prioridade</span></div>
    </article>
    <article class="card detail-summary-card">
        <span class="detail-summary-icon">♙</span>
        <div><span class="detail-summary-label">Operador responsável</span><strong>@(Model.Operador?.Email ?? "Ainda não atribuído")</strong></div>
    </article>
    <article class="card detail-summary-card">
        <span class="detail-summary-icon">⚙</span>
        <div><span class="detail-summary-label">Tipo de manutenção</span><strong>@(Model.TipoManutencao?.Nome() ?? "Não informado")</strong></div>
    </article>
    <article class="card detail-summary-card">
        <span class="detail-summary-icon">↳</span>
        <div><span class="detail-summary-label">Origem</span><strong>@((Model.Origem ?? (Model.AlertaId != null ? OrigemOrdem.Alerta : OrigemOrdem.Manual)).Nome())</strong></div>
    </article>
</div>

<div class="detail-content-grid">
    <section class="card detail-section-card detail-description-card">
        <div class="detail-section-heading">
            <div>
                <p class="eyebrow">ESCOPO DO SERVIÇO</p>
                <h2>Descrição da intervenção</h2>
            </div>
        </div>
        <p class="detail-description os-description">@(string.IsNullOrWhiteSpace(Model.Descricao) ? "Nenhuma descrição informada." : Model.Descricao)</p>

        @if (!string.IsNullOrWhiteSpace(Model.PecasMateriais))
        {
            <div class="detail-origin-note">
                <span class="detail-summary-icon">⚒</span>
                <div>
                    <span class="detail-summary-label">Peças e materiais</span>
                    <strong>@Model.PecasMateriais</strong>
                </div>
            </div>
        }

        @if (Model.Alerta != null)
        {
            <div class="detail-origin-note">
                <span class="detail-summary-icon">◉</span>
                <div>
                    <span class="detail-summary-label">Alerta de origem</span>
                    <strong>@Model.Alerta.Parametro?.Nome · @Model.Alerta.Severidade</strong>
                    <small>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.Alerta.DataHora, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo")).ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            </div>
        }
    </section>

    <section class="card detail-section-card detail-history-card">
        <div class="detail-section-heading">
            <div>
                <p class="eyebrow">ACOMPANHAMENTO</p>
                <h2>Registro da ordem</h2>
            </div>
        </div>
        <div class="detail-timeline">
            <div class="detail-timeline-item">
                <span class="detail-timeline-dot"></span>
                <div><strong>Solicitada por</strong><span>@Model.SolicitanteId</span><small>@Model.DataAbertura.HorarioDeBrasilia()</small></div>
            </div>
            @if (Model.AprovadorId != null)
            {
                <div class="detail-timeline-item">
                    <span class="detail-timeline-dot"></span>
                    <div><strong>Analisada por</strong><span>@Model.AprovadorId</span><small>@Model.DataAprovacao?.HorarioDeBrasilia()</small></div>
                </div>
            }
            @if (Model.DataEncerramento != null)
            {
                <div class="detail-timeline-item">
                    <span class="detail-timeline-dot is-complete"></span>
                    <div><strong>Encerrada</strong><small>@Model.DataEncerramento?.HorarioDeBrasilia()</small></div>
                </div>
            }
        </div>
    </section>
</div>

@if (Model.Itens.Count > 0)
{
    // Marca quem executa: o operador responsável (que só enxerga as próprias OS) e o engenheiro.
    // O gestor aprova a ordem e acompanha, sem marcar.
    var executa = User.IsInRole("Operador") || User.IsInRole("Engenheiro");
    var podeMarcar = Model.Status == StatusOrdem.EmAndamento && executa;
    var podeIniciar = Model.Status == StatusOrdem.Aprovada && User.IsInRole("Engenheiro");
    var situacao = Model.Status switch
    {
        StatusOrdem.Aberta => "Bloqueado: falta o gestor aprovar a OS.",
        StatusOrdem.Aprovada when podeIniciar => "Bloqueado: inicie a manutenção para liberar as etapas.",
        StatusOrdem.Aprovada => "Bloqueado: falta o engenheiro iniciar a manutenção.",
        StatusOrdem.EmAndamento when executa => "Clique em cada etapa conforme for concluída.",
        StatusOrdem.EmAndamento => "Somente leitura: quem marca é o operador responsável ou o engenheiro.",
        StatusOrdem.Encerrada => "OS encerrada. O checklist ficou registrado.",
        _ => "OS rejeitada. O checklist não será executado."
    };
    <section id="checklist" class="card detail-section-card os-checklist @(podeMarcar ? "" : "is-locked")">
        <div class="detail-section-heading">
            <div>
                <p class="eyebrow">EXECUÇÃO</p>
                <h2>Checklist <span class="os-suggestion-count">@Model.Itens.Count(i => i.Concluido)/@Model.Itens.Count</span></h2>
                <p class="section-kicker">@situacao</p>
            </div>
            @if (podeIniciar)
            {
                <form asp-action="Iniciar" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-primary">Iniciar manutenção</button>
                </form>
            }
        </div>
        <ul>
            @foreach (var item in Model.Itens)
            {
                var registro = item.Concluido && item.ConcluidoEm != null
                    ? $"{item.ConcluidoPor} · {item.ConcluidoEm.Value.HorarioDeBrasilia()}"
                    : null;
                <li class="@(item.Concluido ? "is-done" : "")">
                    @if (podeMarcar)
                    {
                        <form asp-action="MarcarItem" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input type="hidden" name="concluido" value="@(item.Concluido ? "false" : "true")" />
                            <button type="submit" class="os-item" aria-pressed="@(item.Concluido ? "true" : "false")">
                                <span class="os-check" aria-hidden="true">@(item.Concluido ? "✓" : "")</span>
                                <span class="os-item-text">
                                    <span>@item.Descricao</span>
                                    @if (registro != null)
                                    {
                                        <small>@registro</small>
                                    }
                                </span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="os-item">
                            <span class="os-check" aria-hidden="true">@(item.Concluido ? "✓" : "")</span>
                            <span class="os-item-text">
                                <span>@item.Descricao</span>
                                @if (registro != null)
                                {
                                    <small>@registro</small>
                                }
                            </span>
                        </div>
                    }
                </li>
            }
        </ul>
    </section>
}

@if (User.IsInRole("Engenheiro") || User.IsInRole("Gestor"))
{
    <form asp-action="Atribuir" method="post" class="os-assignment-form">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="os-assignment-copy">
            <strong>Responsável pela execução</strong>
            <span>Selecione um usuário com perfil de Operador para vincular a esta OS.</span>
        </div>
        <div class="os-assignment-controls">
            <select name="operadorId" asp-items="(SelectList)ViewBag.Operadores" class="form-select" aria-label="Operador responsável">
                <option value="">Sem operador atribuído</option>
            </select>
            <button type="submit" class="btn btn-outline-primary">Salvar atribuição</button>
        </div>
    </form>
}

<section class="detail-actions-card">
    <div class="detail-actions-copy">
        <strong>Ações da ordem</strong>
        <span>As ações disponíveis dependem do status atual e do seu perfil.</span>
    </div>
    <div class="detail-actions-buttons">
        @if (Model.Status == StatusOrdem.Aberta && User.IsInRole("Gestor"))
        {
            <form asp-action="Decidir" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="aprovar" value="true" />
                <button class="btn btn-primary">Aprovar OS</button>
            </form>
            <form asp-action="Decidir" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="aprovar" value="false" />
                <button class="btn btn-outline-danger">Rejeitar</button>
            </form>
        }
        @if (Model.Status == StatusOrdem.Aprovada && User.IsInRole("Engenheiro"))
        {
            <form asp-action="Iniciar" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-primary">Iniciar manutenção</button>
            </form>
        }
        @if (Model.Status == StatusOrdem.EmAndamento && User.IsInRole("Engenheiro"))
        {
            <form asp-action="Encerrar" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-primary">Encerrar OS</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a lista</a>
    </div>
</section>
