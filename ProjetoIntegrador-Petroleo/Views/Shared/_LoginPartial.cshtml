@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav user-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center gap-2"><span class="user-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant())</span><span class="user-name">@User.Identity?.Name</span></li>
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Sair</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
        </li>
    }
</ul>
