@model ProjetoIntegrador_Petroleo.Models.Parametro

@{
    ViewData["Title"] = "Excluir parâmetro";
    var leituras = ViewData["Leituras"] as int? ?? 0;
    var alertas = ViewData["Alertas"] as int? ?? 0;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">CONFIGURAÇÃO DA OPERAÇÃO</p>
        <h1>Excluir parâmetro</h1>
        <p class="page-subtitle">Confira o parâmetro antes de apagar.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar para parâmetros</a>
</section>

<section class="create-card create-card-compact delete-card">
    <div class="create-card-heading">
        <span class="create-card-icon" aria-hidden="true">⌁</span>
        <div>
            <h2>@Model.Nome</h2>
            <p>@Model.Ativo?.Nome <span class="asset-tag">@Model.Ativo?.Tag</span></p>
        </div>
    </div>

    <dl class="delete-facts">
        <div><dt>Unidade</dt><dd>@Model.Unidade</dd></div>
        <div><dt>Limite de atenção</dt><dd>@Model.LimiteAtencao.ToString("0.##") @Model.Unidade</dd></div>
        <div><dt>Limite crítico</dt><dd>@Model.LimiteCritico.ToString("0.##") @Model.Unidade</dd></div>
    </dl>

    <div class="delete-warning" role="alert">
        <strong>⚠ Esta ação não pode ser desfeita.</strong>
        <p>Também serão apagados:</p>
        <ul>
            <li><b>@leituras.ToString("N0")</b> @(leituras == 1 ? "leitura" : "leituras") e as anomalias</li>
            <li><b>@alertas</b> @(alertas == 1 ? "alerta" : "alertas")</li>
        </ul>
        <p>As ordens de serviço continuam no sistema.</p>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="create-form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Excluir parâmetro</button>
        </div>
    </form>
</section>
