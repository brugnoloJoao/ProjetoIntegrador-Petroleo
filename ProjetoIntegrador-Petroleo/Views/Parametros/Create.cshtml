@model ProjetoIntegrador_Petroleo.Models.Parametro

@{
    var voltarAtivo = ViewData["VoltarAtivo"] as int?;
    var voltarUrl = voltarAtivo is { } idDoAtivo
        ? Url.Action("Details", "Ativos", new { id = idDoAtivo })
        : Url.Action("Index");
    ViewData["Title"] = "Novo parâmetro";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">CONFIGURAÇÃO DA OPERAÇÃO</p>
        <h1>Novo parâmetro</h1>
        <p class="page-subtitle">Defina uma variável de monitoramento e seus limites de atenção.</p>
    </div>
    <a href="@voltarUrl" class="btn btn-outline-secondary">← Voltar para @(voltarAtivo == null ? "parâmetros" : "o ativo")</a>
</section>

<section class="create-card">
    <div class="create-card-heading">
        <span class="create-card-icon" aria-hidden="true">⌁</span>
        <div>
            <h2>Configuração do parâmetro</h2>
            <p>Os limites serão usados para identificar condições de atenção e criticidade.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="create-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" name="voltarAtivo" value="@voltarAtivo" />

        <div class="create-form-grid">
            <div class="create-field create-field-wide">
                <label asp-for="AtivoId" class="form-label">Ativo monitorado</label>
                <select asp-for="AtivoId" asp-items="(SelectList)ViewBag.Ativos" class="form-select">
                    <option value="">Selecione um ativo</option>
                </select>
                <span asp-validation-for="AtivoId" class="field-validation"></span>
            </div>

            <partial name="_CamposParametro" model="Model" />

            <div class="create-field">
                <label asp-for="LimiteAtencao" class="form-label">Limite de atenção</label>
                <input asp-for="LimiteAtencao" class="form-control" type="number" step="any" />
                <span asp-validation-for="LimiteAtencao" class="field-validation"></span>
                <span class="create-field-hint">A partir deste valor, a leitura merece acompanhamento.</span>
            </div>

            <div class="create-field">
                <label asp-for="LimiteCritico" class="form-label">Limite crítico</label>
                <input asp-for="LimiteCritico" class="form-control" type="number" step="any" />
                <span asp-validation-for="LimiteCritico" class="field-validation"></span>
                <span class="create-field-hint">Valor que indica uma condição crítica do equipamento.</span>
            </div>
        </div>

        <div class="create-form-actions">
            <a href="@voltarUrl" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Salvar parâmetro <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
