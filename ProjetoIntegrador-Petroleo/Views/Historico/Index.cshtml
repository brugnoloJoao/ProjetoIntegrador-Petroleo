@model ProjetoIntegrador_Petroleo.ViewModels.HistoricoVM
@{
    ViewData["Title"] = "Histórico";
    var fusoUsuario = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    var deLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.De, DateTimeKind.Utc), fusoUsuario);
    var ateLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.Ate, DateTimeKind.Utc), fusoUsuario);
}

<h1>Histórico de leituras</h1>

<form method="get" asp-action="Index" class="row g-3 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Equipamento</label>
        <select name="ativoId" class="form-select" asp-items="Model.Ativos" onchange="this.form.submit()">
            <option value="">Selecione...</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Parâmetro</label>
        <select name="parametroId" class="form-select" asp-items="Model.Parametros">
            <option value="">Selecione...</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">De</label>
        <input type="datetime-local" name="de" class="form-control" value="@deLocal.ToString("yyyy-MM-ddTHH:mm")" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Até</label>
        <input type="datetime-local" name="ate" class="form-control" value="@ateLocal.ToString("yyyy-MM-ddTHH:mm")" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

@if (Model.Erro != null)
{
    <div class="alert alert-danger">@Model.Erro</div>
}
else if (Model.Parametro == null)
{
    <div class="empty-state empty-notice">
        <div class="empty-state-icon">◷</div>
        <h2 class="section-title">Nenhum histórico selecionado</h2>
        <p>Escolha um equipamento e um parâmetro para consultar as leituras.</p>
    </div>
}
else if (Model.TotalLeituras == 0)
{
    <div class="empty-state empty-notice">
        <div class="empty-state-icon">◷</div>
        <h2 class="section-title">Sem leituras neste período</h2>
        <p>Não há dados disponíveis para os filtros selecionados.</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4" data-contar>@Model.TotalLeituras.ToString("N0")</div><div class="text-muted">Leituras</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4" data-contar>@Model.Minimo?.ToString("F1") @Model.Parametro.Unidade</div><div class="text-muted">Mínimo</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4" data-contar>@Model.Media?.ToString("F1") @Model.Parametro.Unidade</div><div class="text-muted">Média</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4" data-contar>@Model.Maximo?.ToString("F1") @Model.Parametro.Unidade</div><div class="text-muted">Máximo</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div id="grafico" class="history-chart" role="img" aria-label="Gráfico de leituras de @Model.Parametro.Nome no período"
                 data-chart="@System.Text.Json.JsonSerializer.Serialize(new {
                     rotulos = Model.Labels,
                     medias = Model.Medias,
                     minimos = Model.Minimos,
                     maximos = Model.Maximos,
                     atencao = Model.Parametro.LimiteAtencao,
                     critico = Model.Parametro.LimiteCritico,
                     unidade = Model.Parametro.Unidade
                 })"></div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">Consulta executada em @Model.TempoConsultaMs ms</small>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Exportar"
           asp-route-parametroId="@Model.ParametroId"
           asp-route-de="@deLocal.ToString("yyyy-MM-ddTHH:mm")"
           asp-route-ate="@ateLocal.ToString("yyyy-MM-ddTHH:mm")">Exportar CSV</a>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead><tr><th>Data/hora</th><th>Valor</th><th>Situação</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Linhas)
                {
                    <tr>
                        <td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(l.DataHora, DateTimeKind.Utc), fusoUsuario).ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@l.Valor.ToString("F2") @Model.Parametro.Unidade</td>
                        <td>
                            @if (l.Valor >= Model.Parametro.LimiteCritico)
                            {
                                <span class="badge bg-danger">⛔ Crítico</span>
                            }
                            else if (l.Valor >= Model.Parametro.LimiteAtencao)
                            {

                                <span class="badge telemetry-warning">⚠ Atenção</span>
                            }
                            else
                            {

                                <span class="badge bg-success">✓ Normal</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="d-flex justify-content-between align-items-center">
        @{
            var de = deLocal.ToString("yyyy-MM-ddTHH:mm");
            var ate = ateLocal.ToString("yyyy-MM-ddTHH:mm");
        }
        @if (Model.Pagina > 1)
        {
            <a class="btn btn-outline-secondary" asp-action="Index"
               asp-route-ativoId="@Model.AtivoId" asp-route-parametroId="@Model.ParametroId"
               asp-route-de="@de" asp-route-ate="@ate" asp-route-pagina="@(Model.Pagina - 1)">← Anterior</a>
        }
        else
        {

            <span></span>
        }

        <span class="text-muted">Página @Model.Pagina de @Model.TotalPaginas</span>

        @if (Model.Pagina < Model.TotalPaginas)
        {
            <a class="btn btn-outline-secondary" asp-action="Index"
               asp-route-ativoId="@Model.AtivoId" asp-route-parametroId="@Model.ParametroId"
               asp-route-de="@de" asp-route-ate="@ate" asp-route-pagina="@(Model.Pagina + 1)">Próxima →</a>
        }
        else
        {

            <span></span>
        }
    </nav>

    @section Scripts {
        <script type="module" src="~/dist/historyChart.js" asp-append-version="true"></script>
    }
}
