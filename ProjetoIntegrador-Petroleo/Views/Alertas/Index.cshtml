@model IEnumerable<ProjetoIntegrador_Petroleo.Models.Alerta>
@using ProjetoIntegrador_Petroleo.Models

@{
    ViewData["Title"] = "Alertas";
    var filtro = ViewData["Filtro"] as string ?? "";
}

<h1>Alertas</h1>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

<div class="btn-group mb-3">
    <a class="btn btn-outline-secondary @(filtro == "" ? "active" : "")" asp-action="Index">Todos</a>
    <a class="btn btn-outline-secondary @(filtro == "Ativo" ? "active" : "")" asp-action="Index" asp-route-status="Ativo">Ativos</a>
    <a class="btn btn-outline-secondary @(filtro == "Reconhecido" ? "active" : "")" asp-action="Index" asp-route-status="Reconhecido">Reconhecidos</a>
    <a class="btn btn-outline-secondary @(filtro == "Normalizado" ? "active" : "")" asp-action="Index" asp-route-status="Normalizado">Normalizados</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum alerta encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Severidade</th>
                    <th>Equipamento</th>
                    <th>Parâmetro</th>
                    <th>Valor</th>
                    <th>Limite violado</th>
                    <th>Data/hora</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @if (a.Severidade == Severidade.Critico)
                            {
                                <span class="badge bg-danger">⛔ Crítico</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">⚠ Atenção</span>
                            }
                        </td>

                        <td>
                            @a.Parametro?.Ativo?.Nome
                            <small class="text-muted">(@a.Parametro?.Ativo?.Tag)</small>
                        </td>

                        <td>@a.Parametro?.Nome</td>

                        <td>@a.ValorMedido.ToString("F1") @a.Parametro?.Unidade</td>

                        <td>@a.LimiteViolado.ToString("F1") @a.Parametro?.Unidade</td>

                        <td>@a.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</td>

                        <td>
                            <span class="badge @(a.Status == StatusAlerta.Ativo ? "bg-danger" : a.Status == StatusAlerta.Reconhecido ? "bg-primary" : "bg-secondary")">
                                @a.Status
                            </span>
                        </td>

                        <td>
                            @if (a.ReconhecidoEm == null && (User.IsInRole("Operador") || User.IsInRole("Engenheiro")))
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Reconhecer" asp-route-id="@a.Id">
                                    Reconhecer
                                </a>
                            }
                            else if (a.ReconhecidoEm != null)
                            {
                                <small class="text-muted" title="@a.Observacao">
                                    por @a.ReconhecidoPorId<br />
                                    @a.ReconhecidoEm?.ToString("dd/MM HH:mm")
                                </small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        setTimeout(() => location.reload(), 30000);
    </script> @* atualiza a cada 30s *@
}