
@model IEnumerable<ProjetoIntegrador_Petroleo.Models.Alerta>
@using ProjetoIntegrador_Petroleo.Models

@{
    ViewData["Title"] = "Alertas";
    var fusoUsuario = TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
    var filtro = ViewData["Filtro"] as string ?? "";
}

<div class="page-heading"><div><p class="eyebrow">Central de eventos</p><h1>Alertas</h1><p class="page-subtitle">Acompanhe desvios e ocorrências dos equipamentos monitorados.</p></div></div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">@TempData["Aviso"]</div>
}

<div id="alert-filters-app" class="mb-3" data-status="@filtro"></div>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum alerta encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Severidade</th>
                    <th>Equipamento</th>
                    <th>Parâmetro</th>
                    <th>Valor</th>
                    <th>Limite violado</th>
                    <th>Data/hora</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr data-alert-row data-status="@a.Status" data-search="@($"{a.Parametro?.Ativo?.Nome} {a.Parametro?.Ativo?.Tag} {a.Parametro?.Nome} {a.Status}")">
                        <td>
                            @if (a.Severidade == Severidade.Critico)
                            {
                                <span class="badge bg-danger">⛔ Crítico</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">⚠ Atenção</span>
                            }
                        </td>

                        <td>
                            @a.Parametro?.Ativo?.Nome
                            <small class="asset-tag">@a.Parametro?.Ativo?.Tag</small>
                        </td>

                        <td>@a.Parametro?.Nome</td>

                        <td>@a.ValorMedido.ToString("F1") @a.Parametro?.Unidade</td>

                        <td>@a.LimiteViolado.ToString("F1") @a.Parametro?.Unidade</td>

                        <td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.DataHora, DateTimeKind.Utc), fusoUsuario).ToString("dd/MM/yyyy HH:mm:ss")</td>

                        <td>
                            <span class="badge @(a.Status == StatusAlerta.Ativo ? "bg-danger" : a.Status == StatusAlerta.Reconhecido ? "bg-primary" : "bg-secondary")">
                                @a.Status
                            </span>
                        </td>

                        <td>
                            @if (a.ReconhecidoEm == null && (User.IsInRole("Operador") || User.IsInRole("Engenheiro")))
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Reconhecer" asp-route-id="@a.Id">
                                    Reconhecer
                                </a>
                            }
                            else if (a.ReconhecidoEm != null)
                            {
                                <small class="text-muted" title="@a.Observacao">
                                    por @a.ReconhecidoPorId<br />
                                    @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.ReconhecidoEm.Value, DateTimeKind.Utc), fusoUsuario).ToString("dd/MM HH:mm")
                                </small>
                            }

                            @if (User.IsInRole("Engenheiro"))
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="OrdemServico"
                                   asp-action="Create"
                                   asp-route-alertaId="@a.Id">
                                    Abrir OS
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script type="module" src="~/dist/filters.js" asp-append-version="true"></script>
    <script>
        setTimeout(() => location.reload(), 30000);
    </script> @* atualiza a cada 30s *@
}
