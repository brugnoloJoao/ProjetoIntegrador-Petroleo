@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Visão geral";
    var parametros = ((IEnumerable<SelectListItem>)ViewBag.Parametros)
        .Select(item => new { value = item.Value ?? "", text = item.Text ?? "Parâmetro" });
}

<div id="dashboard-app"></div>
<script>
    window.petroSyncDashboard = @Html.Raw(Json.Serialize(new {
        autenticado = User.Identity?.IsAuthenticated == true,
        loginUrl = "/Identity/Account/Login",
        indicatorsUrl = Url.Action("Indicadores", "Home"),
        historyUrl = Url.Action("Historico", "Home"),
        exportUrl = User.Identity?.IsAuthenticated == true ? Url.Action("ExportarRelatorio", "Home") : null,
        hubUrl = "/hubs/dashboard",
        parameters = parametros
    }));
</script>

@section Scripts {
    <script type="module" src="~/dist/dashboard.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/dist/assets/dashboard.css" asp-append-version="true" />
}
