@model IEnumerable<ProjetoIntegrador_Petroleo.ViewModels.UsuarioListarVM>
@{
    ViewData["Title"] = "Usuários";
}

<h1>Usuários</h1>
@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}

<p><a class="btn btn-primary" asp-action="Create">Novo usuário</a></p>

<table class="table table-hover align-middle">
    <thead><tr><th>E-mail</th><th>Perfil</th><th>Situação</th><th></th></tr></thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.Perfil</td>
                <td>
                    @if (u.Ativo)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">Desativado</span>
                    }
                </td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Editar</a></td>
            </tr>
        }
    </tbody>
</table>