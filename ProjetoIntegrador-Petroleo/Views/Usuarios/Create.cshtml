@model ProjetoIntegrador_Petroleo.ViewModels.UsuarioCriarVM

@{
    ViewData["Title"] = "Novo usuário";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">ADMINISTRAÇÃO</p>
        <h1>Novo usuário</h1>
        <p class="page-subtitle">Crie um acesso e defina as permissões para a equipe.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar para usuários</a>
</section>

<section class="create-card create-card-compact">
    <div class="create-card-heading">
        <span class="create-card-icon" aria-hidden="true">♙</span>
        <div>
            <h2>Dados de acesso</h2>
            <p>Use um e-mail corporativo e atribua o perfil adequado.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="create-form">
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="create-field">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="nome@empresa.com" autocomplete="email" />
            <span asp-validation-for="Email" class="field-validation"></span>
        </div>

        <div class="create-field">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" class="form-control" type="password" placeholder="Crie uma senha segura" autocomplete="new-password" />
            <span asp-validation-for="Senha" class="field-validation"></span>
            <span class="create-field-hint">Mínimo de 8 caracteres, com letra maiúscula, minúscula, número e símbolo.</span>
        </div>

        <div class="create-field">
            <label asp-for="Perfil" class="form-label"></label>
            <select asp-for="Perfil" asp-items="(List<SelectListItem>)ViewBag.Perfis" class="form-select">
                <option value="">Selecione um perfil</option>
            </select>
            <span asp-validation-for="Perfil" class="field-validation"></span>
        </div>

        <div class="create-form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Criar usuário <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
