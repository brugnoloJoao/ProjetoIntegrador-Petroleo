@model IEnumerable<ProjetoIntegrador_Petroleo.Models.Ativo>

@{
    ViewData["Title"] = "Ativos";
    var ativos = Model.ToList();
    var podeGerenciar = User.IsInRole("Engenheiro") || User.IsInRole("Gestor");
}

<section class="page-heading">
    <div>
        <span class="eyebrow">INVENTÁRIO OPERACIONAL</span>
        <h1>Ativos</h1>
        <p class="page-subtitle">Equipamentos monitorados e seus parâmetros de operação.</p>
    </div>
    @if (podeGerenciar)
    {
        <a class="btn btn-primary" asp-action="Create">＋ Cadastrar ativo</a>
    }
</section>

<section class="card">
    @if (ativos.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">◈</div>
            <h2 class="section-title">Nenhum ativo cadastrado</h2>
            <p>Cadastre um equipamento para começar a acompanhar seus parâmetros e leituras.</p>
            @if (podeGerenciar)
            {
                <a class="btn btn-primary" asp-action="Create">Cadastrar primeiro ativo</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="ps-cartoes table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" data-titulo>Equipamento</th>
                        <th scope="col">Tag</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Status</th>
                        <th scope="col">Parâmetros</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ativos)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Nome</td>
                            <td><span class="asset-tag">@item.Tag</span></td>
                            <td>@(string.IsNullOrWhiteSpace(item.Tipo) ? "—" : item.Tipo)</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case ProjetoIntegrador_Petroleo.Models.StatusAtivo.Operando:
                                        <span class="badge bg-success">Operando</span>
                                        break;
                                    case ProjetoIntegrador_Petroleo.Models.StatusAtivo.EmManutencao:
                                        <span class="badge bg-warning">Em manutenção</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">Parado</span>
                                        break;
                                }
                            </td>
                            <td data-contar>@item.Parametros.Count</td>
                            <td class="text-end">
                                <div class="asset-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Maquina3D" asp-action="Index" asp-route-ativoId="@item.Id">3D</a>
                                    @if (podeGerenciar)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Styles {
    <style>
        .asset-actions { display:flex; justify-content:flex-end; gap:.45rem; white-space:nowrap; }
        .asset-actions .btn { padding:.4rem .65rem; }
        .btn-outline-danger { color:#ff9292; border-color:#704148; }
        .btn-outline-danger:hover { color:#fff; background:#792d35; border-color:#a3424b; }
        @@media (max-width: 720px) { .asset-actions { justify-content:flex-start; } }
    </style>
}
