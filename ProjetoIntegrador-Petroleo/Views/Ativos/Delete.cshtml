@model ProjetoIntegrador_Petroleo.Models.Ativo

@{
    ViewData["Title"] = "Excluir ativo";
    var parametros = Model.Parametros.Count;
    var alertas = ViewData["Alertas"] as int? ?? 0;
    var ordens = ViewData["Ordens"] as int? ?? 0;
    var rotinas = ViewData["Rotinas"] as int? ?? 0;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">INVENTÁRIO OPERACIONAL</p>
        <h1>Excluir ativo</h1>
        <p class="page-subtitle">Confira o equipamento antes de apagar.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Voltar para ativos</a>
</section>

<section class="create-card create-card-compact delete-card">
    <div class="create-card-heading">
        <span class="create-card-icon" aria-hidden="true">◈</span>
        <div>
            <h2>@Model.Nome</h2>
            <p><span class="asset-tag">@Model.Tag</span></p>
        </div>
    </div>

    <dl class="delete-facts">
        <div><dt>Tipo</dt><dd>@(string.IsNullOrWhiteSpace(Model.Tipo) ? "Não informado" : Model.Tipo)</dd></div>
        <div><dt>Status</dt><dd>@(Model.Status == StatusAtivo.EmManutencao ? "Em manutenção" : Model.Status.ToString())</dd></div>
    </dl>

    <div class="delete-warning" role="alert">
        <strong>⚠ Esta ação não pode ser desfeita.</strong>
        <p>Também serão apagados:</p>
        <ul>
            <li><b>@parametros</b> @(parametros == 1 ? "parâmetro" : "parâmetros"), com as leituras e anomalias</li>
            <li><b>@alertas</b> @(alertas == 1 ? "alerta" : "alertas")</li>
            <li><b>@ordens</b> @(ordens == 1 ? "ordem de serviço" : "ordens de serviço")</li>
            <li><b>@rotinas</b> @(rotinas == 1 ? "rotina" : "rotinas") só deste equipamento</li>
        </ul>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="create-form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Excluir ativo</button>
        </div>
    </form>
</section>
