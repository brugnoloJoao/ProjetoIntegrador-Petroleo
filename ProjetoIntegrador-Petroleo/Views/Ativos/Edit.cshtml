@model ProjetoIntegrador_Petroleo.Models.Ativo

@{
    var voltar = ViewData["Voltar"] as string;
    var voltarUrl = voltar == "detalhes" ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index");
    ViewData["Title"] = "Editar ativo";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">INVENTÁRIO OPERACIONAL</p>
        <h1>Editar ativo</h1>
        <p class="page-subtitle">Atualize os dados e a disponibilidade deste equipamento.</p>
    </div>
    <a href="@voltarUrl" class="btn btn-outline-secondary">← Voltar para @(voltar == "detalhes" ? "o ativo" : "ativos")</a>
</section>

<section class="create-card">
    <div class="create-card-heading">
        <span class="create-card-icon" aria-hidden="true">◈</span>
        <div>
            <h2>@Model.Nome</h2>
            <p>Identificação do ativo <strong class="create-record-tag">@Model.Tag</strong></p>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="create-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="voltar" value="@voltar" />

        <div class="create-form-grid">
            <div class="create-field">
                <label asp-for="Nome" class="form-label">Nome do equipamento</label>
                <input asp-for="Nome" class="form-control" autocomplete="off" />
                <span asp-validation-for="Nome" class="field-validation"></span>
            </div>

            <div class="create-field">
                <label asp-for="Tag" class="form-label">Tag de identificação</label>
                <input asp-for="Tag" class="form-control" autocomplete="off" />
                <span asp-validation-for="Tag" class="field-validation"></span>
            </div>

            <div class="create-field">
                <label asp-for="Tipo" class="form-label">Tipo de equipamento</label>
                <partial name="_SelectTipo" model='("Tipo", Model.Tipo)' />
                <span class="create-field-hint">O tipo define o modelo 3D da máquina.</span>
                <span asp-validation-for="Tipo" class="field-validation"></span>
            </div>

            <div class="create-field">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusAtivo>()" class="form-select"></select>
                <span asp-validation-for="Status" class="field-validation"></span>
            </div>
        </div>

        <div class="create-form-actions">
            <a href="@voltarUrl" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Salvar alterações <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
